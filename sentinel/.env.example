# Postgres connection string for the *sentinel_executor* role — NOT service_role.
# postgres://sentinel_executor:<password>@db.<project-ref>.supabase.co:5432/postgres
SENTINEL_DB_URL=

# Anthropic API key used for the Decomposer, executors, and the Judge.
ANTHROPIC_API_KEY=

# Vercel injects this as the Authorization bearer on cron invocations of /api/tick.
CRON_SECRET=

# Supabase project's JWT secret (Project Settings -> API -> JWT Settings).
# Used to verify each caller's own Supabase access token on
# POST /api/goals/decompose. There is no shared secret for this endpoint —
# every request is authenticated as the specific end user who owns the goal.
SUPABASE_JWT_SECRET=

# Bearer token for GET /api/mission-control ONLY. Admin/dashboard access —
# distinct from anything client-facing. Never ship this to a browser: it
# reads global operational data with no per-user scoping.
SENTINEL_ADMIN_SECRET=
