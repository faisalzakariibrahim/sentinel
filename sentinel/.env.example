# Postgres connection string for the *sentinel_executor* role — NOT service_role.
# postgres://sentinel_executor:<password>@db.<project-ref>.supabase.co:5432/postgres
SENTINEL_DB_URL=

# Anthropic API key used for the Decomposer, executors, and the Judge.
ANTHROPIC_API_KEY=

# Vercel injects this as the Authorization bearer on cron invocations of /api/tick.
CRON_SECRET=

# Bearer token required by the on-demand endpoints (/api/goals/decompose, /api/mission-control).
SENTINEL_API_SECRET=
